{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Windows Executable with PyInstaller",
            "type": "shell",
            "command": "pyinstaller",
            "args": [
                "--onefile",
                "--add-data",
                "'songs_app/infra;songs_app/infra'",
                "--icon='songs_app/resources/music.ico'",
                "--distpath",
                "build_win",
                "--workpath",
                "build_win/build_temp",
                "songs_app/master.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "This task builds the executable using PyInstaller with icon and data."
        },
        {
            "label": "Build macOS Executable with PyInstaller",
            "type": "shell",
            "command": "pyinstaller",
            "args": [
                "--onefile",
                "--add-data",
                "songs_app/infra:songs_app/infra",
                "--icon=songs_app/resources/music.icns",
                "--distpath",
                "build_macOS",
                "--workpath",
                "build_macOS/build_temp",
                "songs_app/master.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "This task builds the macOS executable into 'build_macOS' using PyInstaller."
        },
            {"label": "Load dependencies",
            "type": "shell",
            "command": "python3",
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "requirements.txt"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Streamlit App",
            "type": "shell",
            "command": "streamlit",
            "args": ["run", "songs_app/master_stream.py"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}


